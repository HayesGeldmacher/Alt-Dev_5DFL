    - target: {fileID: 8597233004686569379, guid: 8c6d16fe95f5ef84b8f1c9f9dc325c42,
        type: 3}
      propertyPath: _dialogueClips.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 8597233004686569379, guid: 8c6d16fe95f5ef84b8f1c9f9dc325c42,
        type: 3}
      propertyPath: '_dialogueClips.Array.data[4]'
      value: 
      objectReference: {fileID: 8300000, guid: fac13f1561973864a9e2aa25359ca0b5, type: 3}
    - target: {fileID: 8597233004686569379, guid: 8c6d16fe95f5ef84b8f1c9f9dc325c42,
        type: 3}
      propertyPath: '_dialogueClips.Array.data[5]'
      value: 
      objectReference: {fileID: 8300000, guid: c4f366aa922031a448930cbe6dcf7fa5, type: 3}
    - target: {fileID: 8597233004686569379, guid: 8c6d16fe95f5ef84b8f1c9f9dc325c42,
        type: 3}
      propertyPath: '_dialogueClips.Array.data[6]'
      value: 
      objectReference: {fileID: 8300000, guid: f8b8d6bbcc480014f8252f050d9f852a, type: 3}
    - target: {fileID: 8597233004686569379, guid: 8c6d16fe95f5ef84b8f1c9f9dc325c42,
        type: 3}
      propertyPath: _dialogue._sentences.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 8597233004686569379, guid: 8c6d16fe95f5ef84b8f1c9f9dc325c42,
        type: 3}
      propertyPath: '_dialogue._sentences.Array.data[1]'
      value: Did you like my little appearance there? I bet I'm hardly recognizable
        in my birthday getup!
      objectReference: {fileID: 0}
    - target: {fileID: 8597233004686569379, guid: 8c6d16fe95f5ef84b8f1c9f9dc325c42,
        type: 3}
      propertyPath: '_dialogue._sentences.Array.data[2]'
      value: "I dreamt I was watching a movie - it was a horror film, I think. \r"
      objectReference: {fileID: 0}
    - target: {fileID: 8597233004686569379, guid: 8c6d16fe95f5ef84b8f1c9f9dc325c42,
        type: 3}
      propertyPath: '_dialogue._sentences.Array.data[3]'
      value: "Every room was dark and filled with corners.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 8597233004686569379, guid: 8c6d16fe95f5ef84b8f1c9f9dc325c42,
        type: 3}
      propertyPath: '_dialogue._sentences.Array.data[4]'
      value: 'You were there too, pal. I wonder what this room will look like when
        it''s all corners? '
      objectReference: {fileID: 0}
    - target: {fileID: 8597233004686569379, guid: 8c6d16fe95f5ef84b8f1c9f9dc325c42,
        type: 3}
      propertyPath: '_dialogue._sentences.Array.data[5]'
      value: 'Anyways, this is just backstage stuff. But next time you see me, it''lll
        be the real deal. '
      objectReference: {fileID: 0}
    - target: {fileID: 8597233004686569379, guid: 8c6d16fe95f5ef84b8f1c9f9dc325c42,
        type: 3}
      propertyPath: '_dialogue._sentences.Array.data[6]'
      value: 'Good night, buddy. '
      objectReference: {fileID: 0}
